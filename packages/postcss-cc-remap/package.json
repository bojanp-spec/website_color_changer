{
  "name": "postcss-cc-remap",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "PostCSS plugin: primenjuje mapu boja iz cc-export na izvorne CSS/SCSS fajlove",
  "main": "dist/index.js",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "peerDependencies": {
    "postcss": "^8.4.0"
  },
  "dependencies": {
    "@cc/core": "0.1.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "postcss": "^8.5.30",
    "postcss-scss": "^4.0.9"
  }
}
